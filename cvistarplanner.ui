   <string notr="true">
QMainWindow {
    background-color: #1e1e23;
}
QMenuBar {
    background-color: #2d2d35;
    color: #ffffff;
    border-bottom: 1px solid #404050;
    padding: 2px;
    font-weight: bold;
}
QMenuBar::item {
    background-color: transparent;
    padding: 8px 15px;
    margin: 0px;
}
QMenuBar::item:selected {
    background-color: #4a90d9;
    border-radius: 4px;
}
QMenuBar::item:pressed {
    background-color: #3a7bc8;
}
QMenu {
    background-color: #2d2d35;
    color: #ffffff;
    border: 1px solid #404050;
    padding: 5px;
}
QMenu::item {
    padding: 8px 25px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: #4a90d9;
}
QMenu::separator {
    height: 1px;
    background: #404050;
    margin: 5px 10px;
}
QToolBar {
    background-color: #252530;
    border: none;
    padding: 5px;
    spacing: 5px;
}
QToolButton {
    background-color: #3d3d48;
    border: 1px solid #505060;
    border-radius: 6px;
    padding: 8px;
    color: white;
    min-width: 40px;
    min-height: 40px;
}
QToolButton:hover {
    background-color: #4a90d9;
    border-color: #5aa0e9;
}
QToolButton:pressed {
    background-color: #3a7bc8;
}
QToolButton:checked {
    background-color: #4a90d9;
    border: 2px solid #7ab8f5;
}
QDockWidget {
    color: #ffffff;
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(float.png);
}
QDockWidget::title {
    background-color: #353540;
    padding: 8px;
    font-weight: bold;
    border-bottom: 2px solid #4a90d9;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
}
QGroupBox {
    color: #4a90d9;
    border: 1px solid #404050;
    border-radius: 6px;
    margin-top: 12px;
    padding: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #4a90d9;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a4a55,
                                stop:1 #3a3a45);
    border: 1px solid #505060;
    color: white;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: 500;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5a65,
                                stop:1 #4a4a55);
    border-color: #606070;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3a3a45,
                                stop:1 #2a2a35);
}
QPushButton:disabled {
    background: #2a2a35;
    color: #606070;
}
QComboBox {
    background-color: #3d3d48;
    border: 1px solid #505060;
    border-radius: 4px;
    padding: 6px 10px;
    color: white;
    min-width: 100px;
}
QComboBox:hover {
    border-color: #4a90d9;
}
QComboBox::drop-down {
    border: none;
    width: 25px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #ffffff;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #3d3d48;
    border: 1px solid #505060;
    selection-background-color: #4a90d9;
    color: white;
}
QLineEdit {
    background-color: #2d2d35;
    border: 1px solid #505060;
    border-radius: 4px;
    padding: 6px;
    color: #00ff00;
    font-family: "Consolas", monospace;
}
QLineEdit:focus {
    border-color: #4a90d9;
}
QSpinBox, QDoubleSpinBox {
    background-color: #2d2d35;
    border: 1px solid #505060;
    border-radius: 4px;
    padding: 4px;
    color: white;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #4a90d9;
}
QCheckBox {
    color: white;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 1px solid #505060;
    background-color: #2d2d35;
}
QCheckBox::indicator:checked {
    background-color: #4a90d9;
    border-color: #4a90d9;
}
QLabel {
    color: #e0e0e0;
}
QTableWidget {
    background-color: #1e1e23;
    gridline-color: #404050;
    color: white;
    border: 1px solid #404050;
    border-radius: 4px;
}
QTableWidget::item {
    padding: 5px;
    border: none;
}
QTableWidget::item:selected {
    background-color: #4a90d9;
}
QHeaderView::section {
    background-color: #353540;
    color: #90ee90;
    padding: 8px;
    border: 1px solid #404050;
    font-weight: bold;
}
QScrollBar:vertical {
    background-color: #2d2d35;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #505060;
    min-height: 30px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background-color: #606070;
}
QScrollBar:horizontal {
    background-color: #2d2d35;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #505060;
    min-width: 30px;
    border-radius: 6px;
}
QSlider::groove:vertical {
    background: #2d2d35;
    width: 8px;
    border-radius: 4px;
}
QSlider::handle:vertical {
    background: #4a90d9;
    height: 20px;
    margin: 0 -6px;
    border-radius: 10px;
}
QSlider::groove:horizontal {
    background: #2d2d35;
    height: 8px;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #4a90d9;
    width: 20px;
    margin: -6px 0;
    border-radius: 10px;
}
QStatusBar {
    background-color: #252530;
    color: white;
    border-top: 1px solid #404050;
}
