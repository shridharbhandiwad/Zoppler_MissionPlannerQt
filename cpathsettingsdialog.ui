  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: rgb(30, 30, 40);
    color: white;
}
QLabel {
    color: white;
    font-weight: bold;
    font-size: 9pt;
}
QGroupBox {
    color: #FFB74D;
    font-weight: bold;
    font-size: 10pt;
    border: 2px solid rgba(255, 152, 0, 0.4);
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    left: 8px;
}
QSpinBox, QDoubleSpinBox {
    background-color: rgb(50, 50, 65);
    color: white;
    border: 1px solid rgba(255, 152, 0, 0.5);
    border-radius: 4px;
    padding: 3px;
    font-size: 9pt;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid rgba(255, 167, 38, 0.8);
}
QCheckBox {
    color: white;
    font-size: 9pt;
}
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QScrollBar:vertical {
    background-color: rgb(40, 40, 50);
    width: 12px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background-color: rgba(255, 152, 0, 0.6);
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 152, 0, 0.8);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 152, 0, 0.85),
                                stop:0.5 rgba(245, 124, 0, 0.85),
                                stop:1 rgba(230, 81, 0, 0.85));
    border: 2px solid rgba(255, 152, 0, 0.4);
    color: white;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 9pt;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 167, 38, 0.9),
                                stop:0.5 rgba(255, 152, 0, 0.9),
                                stop:1 rgba(245, 124, 0, 0.9));
    border: 2px solid rgba(255, 167, 38, 0.6);
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(230, 81, 0, 0.9),
                                stop:1 rgba(191, 54, 12, 0.9));
}
QPushButton#pushButton_ResetDefaults {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(97, 97, 97, 0.85),
                                stop:1 rgba(66, 66, 66, 0.85));
    border: 2px solid rgba(150, 150, 150, 0.4);
}
QPushButton#pushButton_ResetDefaults:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(117, 117, 117, 0.9),
                                stop:1 rgba(97, 97, 97, 0.9));
}
QPushButton#pushButton_Cancel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(97, 97, 97, 0.85),
                                stop:1 rgba(66, 66, 66, 0.85));
    border: 2px solid rgba(150, 150, 150, 0.4);
}
QPushButton#pushButton_Cancel:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
