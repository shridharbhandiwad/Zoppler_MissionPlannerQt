    border: 1px solid rgba(71, 85, 105, 0.3);
    color: white;
}
QLabel {
    color: rgba(226, 232, 240, 0.95);
    font-weight: 600;
    font-size: 10pt;
}
QGroupBox {
    color: rgba(251, 146, 60, 1);
    font-weight: 700;
    font-size: 11pt;
    border: 2px solid rgba(234, 88, 12, 0.5);
    border-radius: 14px;
    margin-top: 14px;
    padding: 18px 14px 14px 14px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(30, 41, 59, 0.8),
                                stop:1 rgba(51, 65, 85, 0.8));
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 12px;
    left: 14px;
    color: rgba(253, 186, 116, 1);
}
QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(30, 41, 59, 0.95),
                                stop:1 rgba(15, 23, 42, 0.95));
    color: rgba(226, 232, 240, 0.95);
    border: 2px solid rgba(234, 88, 12, 0.4);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 10pt;
    font-weight: 500;
    selection-background-color: rgba(234, 88, 12, 0.5);
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid rgba(251, 146, 60, 0.8);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(30, 41, 59, 0.98),
                                stop:1 rgba(15, 23, 42, 0.98));
}
QSpinBox:hover, QDoubleSpinBox:hover {
    border: 2px solid rgba(249, 115, 22, 0.6);
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid rgba(234, 88, 12, 0.3);
    border-top-right-radius: 6px;
    background: rgba(234, 88, 12, 0.2);
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background: rgba(234, 88, 12, 0.4);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    border-left: 1px solid rgba(234, 88, 12, 0.3);
    border-bottom-right-radius: 6px;
    background: rgba(234, 88, 12, 0.2);
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(234, 88, 12, 0.4);
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(249, 115, 22, 0.95),
                                stop:0.4 rgba(234, 88, 12, 0.95),
