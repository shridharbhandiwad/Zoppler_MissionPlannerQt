  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: rgb(30, 30, 40);
    color: white;
}
QLabel {
    color: white;
    font-weight: bold;
    font-size: 10pt;
}
QGroupBox {
    color: #FFB74D;
    font-weight: bold;
    font-size: 11pt;
    border: 2px solid rgba(255, 152, 0, 0.4);
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 10px;
}
QGroupBox#groupBox_GenerationMethod {
    color: #64B5F6;
    border: 2px solid rgba(100, 181, 246, 0.5);
}
QGroupBox#groupBox_AISettings {
    color: #81C784;
    border: 2px solid rgba(129, 199, 132, 0.5);
}
QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: rgb(50, 50, 65);
    color: white;
    border: 1px solid rgba(255, 152, 0, 0.5);
    border-radius: 4px;
    padding: 5px;
    font-size: 10pt;
}
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid rgba(255, 167, 38, 0.8);
}
QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid white;
    margin-right: 5px;
}
QComboBox QAbstractItemView {
    background-color: rgb(50, 50, 65);
    color: white;
    selection-background-color: rgba(255, 152, 0, 0.6);
}
QRadioButton {
    color: white;
    font-weight: bold;
    font-size: 10pt;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}
QRadioButton::indicator:unchecked {
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 10px;
    background-color: transparent;
}
QRadioButton::indicator:checked {
    border: 2px solid rgba(100, 181, 246, 0.8);
    border-radius: 10px;
    background-color: rgba(100, 181, 246, 0.6);
}
QCheckBox {
    color: white;
    font-weight: bold;
    font-size: 10pt;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
}
QCheckBox::indicator:unchecked {
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 4px;
    background-color: transparent;
}
QCheckBox::indicator:checked {
    border: 2px solid rgba(129, 199, 132, 0.8);
    border-radius: 4px;
    background-color: rgba(129, 199, 132, 0.6);
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 152, 0, 0.85),
                                stop:0.5 rgba(245, 124, 0, 0.85),
                                stop:1 rgba(230, 81, 0, 0.85));
    border: 2px solid rgba(255, 152, 0, 0.4);
    color: white;
    padding: 10px 25px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 10pt;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 167, 38, 0.9),
                                stop:0.5 rgba(255, 152, 0, 0.9),
                                stop:1 rgba(245, 124, 0, 0.9));
    border: 2px solid rgba(255, 167, 38, 0.6);
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(230, 81, 0, 0.9),
                                stop:1 rgba(191, 54, 12, 0.9));
}
QPushButton#pushButton_ResetDefaults {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(97, 97, 97, 0.85),
                                stop:1 rgba(66, 66, 66, 0.85));
    border: 2px solid rgba(150, 150, 150, 0.4);
}
QPushButton#pushButton_ResetDefaults:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(117, 117, 117, 0.9),
                                stop:1 rgba(97, 97, 97, 0.9));
}
QPushButton#pushButton_Cancel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(97, 97, 97, 0.85),
                                stop:1 rgba(66, 66, 66, 0.85));
    border: 2px solid rgba(150, 150, 150, 0.4);
}
QPushButton#pushButton_Cancel:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(117, 117, 117, 0.9),
                                stop:1 rgba(97, 97, 97, 0.9));
}
QPushButton#pushButton_SaveAsDefaults {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(76, 175, 80, 0.85),
                                stop:0.5 rgba(67, 160, 71, 0.85),
                                stop:1 rgba(56, 142, 60, 0.85));
    border: 2px solid rgba(76, 175, 80, 0.4);
}
QPushButton#pushButton_SaveAsDefaults:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(102, 187, 106, 0.9),
                                stop:0.5 rgba(76, 175, 80, 0.9),
                                stop:1 rgba(67, 160, 71, 0.9));
    border: 2px solid rgba(102, 187, 106, 0.6);
}
QPushButton#pushButton_SaveAsDefaults:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(56, 142, 60, 0.9),
                                stop:1 rgba(46, 125, 50, 0.9));
}
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}</string>
