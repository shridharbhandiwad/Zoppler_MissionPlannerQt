  <property name="styleSheet">
   <string notr="true">/* ===============================
   Main Widget Background - Dark Theme
   =============================== */
QWidget {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(15, 23, 42, 0.98),
        stop:0.5 rgba(30, 41, 59, 0.98),
        stop:1 rgba(15, 23, 42, 0.98)
    );
    font-family: Segoe UI, Roboto, sans-serif;
    font-size: 14px;
    color: rgba(226, 232, 240, 0.95);
    border-radius: 12px;
}

/* ===============================
   Labels
   =============================== */
QLabel {
    color: rgba(226, 232, 240, 0.95);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
}


/* ===============================
   Buttons
   =============================== */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(59, 130, 246, 0.95),
                                stop:0.4 rgba(37, 99, 235, 0.95),
                                stop:1 rgba(29, 78, 216, 0.95));
    color: white;
    padding: 10px 18px;
    border-radius: 10px;
    border: 2px solid rgba(96, 165, 250, 0.5);
    font-weight: 700;
    letter-spacing: 0.5px;
    font-size: 11px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(96, 165, 250, 0.95),
                                stop:0.4 rgba(59, 130, 246, 0.95),
                                stop:1 rgba(37, 99, 235, 0.95));
    border: 2px solid rgba(147, 197, 253, 0.7);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(30, 64, 175, 0.95),
                                stop:1 rgba(30, 58, 138, 0.95));
    border: 2px solid rgba(59, 130, 246, 0.8);
    padding: 11px 18px 9px 18px;
}

QPushButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(71, 85, 105, 0.7),
                                stop:1 rgba(51, 65, 85, 0.7));
    border: 2px solid rgba(71, 85, 105, 0.3);
    color: rgba(255, 255, 255, 0.35);
}

/* Close Button (Red Theme) */
QPushButton#pushButton_close {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(239, 68, 68, 0.95),
                                stop:0.4 rgba(220, 38, 38, 0.95),
                                stop:1 rgba(185, 28, 28, 0.95));
    border: 2px solid rgba(248, 113, 113, 0.5);
}

QPushButton#pushButton_close:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(248, 113, 113, 0.95),
                                stop:0.4 rgba(239, 68, 68, 0.95),
                                stop:1 rgba(220, 38, 38, 0.95));
    border: 2px solid rgba(252, 165, 165, 0.7);
}

QPushButton#pushButton_close:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(127, 29, 29, 0.95),
                                stop:1 rgba(153, 27, 27, 0.95));
    border: 2px solid rgba(185, 28, 28, 0.8);
    padding: 11px 18px 9px 18px;
}

/* Update Button (Green Theme) */
QPushButton#pushButton_update {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(34, 197, 94, 0.95),
                                stop:0.4 rgba(22, 163, 74, 0.95),
                                stop:1 rgba(21, 128, 61, 0.95));
    border: 2px solid rgba(74, 222, 128, 0.5);
}

QPushButton#pushButton_update:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(74, 222, 128, 0.95),
                                stop:0.4 rgba(34, 197, 94, 0.95),
                                stop:1 rgba(22, 163, 74, 0.95));
    border: 2px solid rgba(134, 239, 172, 0.7);
}

QPushButton#pushButton_update:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(20, 83, 45, 0.95),
                                stop:1 rgba(22, 101, 52, 0.95));
    border: 2px solid rgba(34, 197, 94, 0.8);
    padding: 11px 18px 9px 18px;
}

/* ===============================
   Table Widget Background + Border
   =============================== */
QTableWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(30, 41, 59, 0.95),
                                stop:1 rgba(15, 23, 42, 0.95));
    border: 2px solid rgba(71, 85, 105, 0.5);
    border-radius: 12px;
    gridline-color: rgba(71, 85, 105, 0.4);
    font-size: 13px;
    selection-background-color: rgba(59, 130, 246, 0.5);
    selection-color: white;
    color: rgba(226, 232, 240, 0.95);
}

/* ===============================
   Table Header
   =============================== */
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(51, 65, 85, 0.9),
                                stop:1 rgba(30, 41, 59, 0.9));
    color: rgba(147, 197, 253, 1);
    padding: 10px 12px;
    border: 1px solid rgba(71, 85, 105, 0.5);
    font-weight: 700;
    font-size: 11pt;
    border-radius: 0px;
}

QHeaderView::section:first {
    border-top-left-radius: 10px;
}

QHeaderView::section:last {
    border-top-right-radius: 10px;
}

/* Remove the small triangle indicator background */
QHeaderView::down-arrow,
QHeaderView::up-arrow {
    width: 10px;
    height: 10px;
}

/* ===============================
   Alternating Row Colors
   =============================== */
QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid rgba(71, 85, 105, 0.3);
}

QTableWidget::item:alternate {
    background: rgba(51, 65, 85, 0.3);
}

/* Hover effect */
QTableWidget::item:hover {
    background: rgba(59, 130, 246, 0.25);
}

/* Selected row */
QTableWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(59, 130, 246, 0.6),
                                stop:1 rgba(96, 165, 250, 0.4));
    color: white;
}

/* ===============================
   Scrollbars
   =============================== */
QScrollBar:vertical {
    width: 10px;
    background: rgba(30, 41, 59, 0.5);
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: rgba(71, 85, 105, 0.8);
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(100, 116, 139, 0.9);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    height: 10px;
    background: rgba(30, 41, 59, 0.5);
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: rgba(71, 85, 105, 0.8);
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(100, 116, 139, 0.9);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===============================
   ComboBox (Dropdown) Styling
   =============================== */
QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(55, 65, 81, 0.95),
                                stop:0.5 rgba(45, 55, 72, 0.95),
                                stop:1 rgba(37, 47, 63, 0.95));
    border: 2px solid rgba(71, 85, 105, 0.5);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    color: rgba(226, 232, 240, 0.95);
}

QComboBox:hover {
    border: 2px solid rgba(96, 165, 250, 0.6);
}

QComboBox:focus {
    border: 2px solid rgba(96, 165, 250, 0.8);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    border-left: 1px solid rgba(71, 85, 105, 0.4);
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background: transparent;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background: rgba(37, 47, 63, 0.98);
    border: 2px solid rgba(71, 85, 105, 0.6);
    border-radius: 8px;
    padding: 6px;
    selection-background-color: rgba(59, 130, 246, 0.5);
    selection-color: white;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 2px;
    color: rgba(226, 232, 240, 0.95);
}

QComboBox QAbstractItemView::item:hover {
    background: rgba(59, 130, 246, 0.3);
}</string>
