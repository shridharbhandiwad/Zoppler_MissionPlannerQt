<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="VistarPlanner"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1
                         http://www.topografix.com/GPX/1/1/gpx.xsd">

  <metadata>
    <name>Sample GPX Mission</name>
    <desc>A sample mission with waypoints, a patrol track and a route for VistarPlanner GPX import testing</desc>
    <author>
      <name>System</name>
    </author>
    <time>2026-04-03T00:00:00Z</time>
  </metadata>

  <!-- Waypoints – loaded as ScenarioObjects -->
  <wpt lat="28.5000" lon="77.2000">
    <ele>100.0</ele>
    <name>RADAR_001</name>
    <type>RADAR</type>
    <desc>Primary radar installation</desc>
    <sym>Radio Beacon</sym>
  </wpt>

  <wpt lat="28.5100" lon="77.2100">
    <ele>50.0</ele>
    <name>LAUNCHER_001</name>
    <type>LAUNCHER</type>
    <desc>Missile launcher battery</desc>
    <sym>Military</sym>
  </wpt>

  <wpt lat="28.4800" lon="77.1800">
    <ele>5000.0</ele>
    <name>FIGHTER_001</name>
    <type>FIGHTER</type>
    <desc>Fighter aircraft – callsign ALPHA-1</desc>
    <sym>Airplane</sym>
  </wpt>

  <!-- Route – loaded as ScenarioRoute (gpxType = "route") -->
  <rte>
    <name>Intercept Vector</name>
    <type>intercept</type>
    <rtept lat="28.4800" lon="77.1800">
      <ele>8000.0</ele>
      <name>WP1</name>
    </rtept>
    <rtept lat="28.5500" lon="77.2500">
      <ele>10000.0</ele>
      <name>WP2</name>
    </rtept>
    <rtept lat="28.6500" lon="77.3500">
      <ele>12000.0</ele>
      <name>WP3</name>
    </rtept>
  </rte>

  <!-- Track – loaded as ScenarioRoute (gpxType = "track") -->
  <trk>
    <name>CAP Route Alpha</name>
    <type>patrol</type>
    <trkseg>
      <trkpt lat="28.4500" lon="77.1500">
        <ele>5000.0</ele>
      </trkpt>
      <trkpt lat="28.5500" lon="77.1500">
        <ele>5000.0</ele>
      </trkpt>
      <trkpt lat="28.5500" lon="77.2500">
        <ele>5000.0</ele>
      </trkpt>
      <trkpt lat="28.4500" lon="77.2500">
        <ele>5000.0</ele>
      </trkpt>
      <trkpt lat="28.4500" lon="77.1500">
        <ele>5000.0</ele>
      </trkpt>
    </trkseg>
  </trk>

</gpx>
